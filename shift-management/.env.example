# Copy this file to `.env` and fill in the values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API
#
# Only these two values are needed. Never put the service_role / secret key in
# a Vite app — anything prefixed with VITE_ is shipped to the browser.
#
# Vite reads .env once at startup: restart the dev server after editing it.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Newer Supabase projects label this the "publishable" key (sb_publishable_...).
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Older projects label the same value the "anon public" key (a JWT). If your
# dashboard shows that instead, use this variable rather than the one above.
# VITE_SUPABASE_ANON_KEY=your-anon-public-key
